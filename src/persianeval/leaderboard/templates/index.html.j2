<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<style>
  :root {
    --bg: #f8fafc; --surface: #ffffff; --text: #0f172a; --muted: #64748b;
    --accent: #0ea5a4; --border: #e2e8f0;
  }
  @media (prefers-color-scheme: dark) {
    :root { --bg: #0b1220; --surface: #111a2c; --text: #e2e8f0; --muted: #94a3b8; --border: #1e293b; }
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--text);
         font-family: Vazirmatn, "Segoe UI", Tahoma, sans-serif; line-height: 1.7; }
  .wrap { max-width: 1080px; margin: 0 auto; padding: 2.5rem 1.25rem 4rem; }
  header h1 { margin: 0 0 .3rem; font-size: 1.9rem; }
  header h1 a { color: inherit; text-decoration: none; border-bottom: 3px solid var(--accent); }
  header p { margin: 0 0 2rem; color: var(--muted); }
  .banner { display: flex; flex-wrap: wrap; gap: 1rem; align-items: center; margin-bottom: 2rem; }
  .banner svg { max-width: 480px; width: 100%; height: auto; }
  .radar-box { background: var(--surface); border: 1px solid var(--border); border-radius: 14px;
               padding: 1.25rem; color: var(--text); }
  .radar-box h2 { margin: 0 0 .75rem; font-size: 1.05rem; }
  .legend { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: .75rem; font-size: .85rem; color: var(--muted); }
  .legend span::before { content: ""; display: inline-block; width: .8em; height: .8em; margin-inline-end: .35em;
                         border-radius: 2px; background: var(--c); }
  table { width: 100%; border-collapse: collapse; background: var(--surface); border: 1px solid var(--border);
          border-radius: 14px; overflow: hidden; font-variant-numeric: tabular-nums; }
  th, td { padding: .65rem .8rem; text-align: center; border-bottom: 1px solid var(--border); }
  th { background: var(--surface); cursor: pointer; user-select: none; font-size: .85rem; color: var(--muted); }
  th:hover { color: var(--accent); }
  th .arrow { opacity: .5; }
  td.model { text-align: right; direction: ltr; font-weight: 600; }
  td .bar { display: block; height: 6px; border-radius: 3px; background: var(--accent); margin-top: .3rem; }
  td.overall { font-weight: 800; color: var(--accent); }
  tr:hover td { background: color-mix(in srgb, var(--accent) 6%, transparent); }
  .empty { background: var(--surface); border: 1px dashed var(--border); border-radius: 14px;
           padding: 2.5rem 1.5rem; text-align: center; color: var(--muted); }
  .tasks { margin-top: 2.5rem; display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: .8rem; }
  .task-card { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: .8rem 1rem; }
  .task-card b { display: block; }
  .task-card small { color: var(--muted); }
  footer { margin-top: 3rem; color: var(--muted); font-size: .85rem; border-top: 1px solid var(--border); padding-top: 1rem; }
  footer a { color: var(--accent); }
</style>
</head>
<body>
<div class="wrap">
  <header>
    <h1><a href="https://github.com/Abolfazlrwm/persianeval">PersianEval</a></h1>
    <p>بنچمارک متن‌باز ارزیابی مدل‌های زبانی فارسی — به‌روزرسانی هفتگی توسط GitHub Actions ·
       Open-source benchmark for Persian LLMs — refreshed weekly by GitHub Actions</p>
  </header>

  {% if has_results %}
  <div class="banner">
    <div class="radar-box">
      <h2>مقایسهٔ مدل‌ها بر اساس ۸ تسک · Per-task model comparison</h2>
      {{ radar | safe }}
      <div class="legend">
        {% for row in rows[:6] %}<span style="--c: {{ row.colors }}">{{ row.model }}</span>{% endfor %}
      </div>
    </div>
  </div>

  <table id="board">
    <thead>
      <tr>
        <th data-key="rank"># <span class="arrow"></span></th>
        <th data-key="model">Model</th>
        <th data-key="org">Org</th>
        <th data-key="license">License</th>
        <th data-key="overall">Overall % <span class="arrow"></span></th>
        {% for en, fa in task_labels %}<th data-key="{{ en.lower() }}">{{ fa }}<br><small>{{ en }}</small></th>{% endfor %}
      </tr>
    </thead>
    <tbody>
      {% for row in rows %}
      <tr>
        <td data-v="{{ row.rank }}">{{ row.rank }}</td>
        <td class="model" data-v="{{ row.model }}">{{ row.model }}</td>
        <td data-v="{{ row.org }}">{{ row.org or "—" }}</td>
        <td data-v="{{ row.license }}">{{ row.license or "—" }}</td>
        <td class="overall" data-v="{{ row.overall }}">{{ "%.1f" | format(row.overall) }}
          <span class="bar" style="width: {{ row.overall }}%"></span></td>
        {% for en, fa in task_labels %}
          {% set key = en.lower() %}
          <td data-v="{{ row.tasks.get(key, '-') }}">
            {{ "%.1f" | format(row.tasks[key]) if key in row.tasks else "—" }}
          </td>
        {% endfor %}
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {% else %}
  <div class="empty">
    هنوز نتیجه‌ای ثبت نشده است. اولین اجرای هفتگی (<code>leaderboard.yml</code>) این جدول را پر می‌کند —
    یا با <code>persianeval run</code> و سپس <code>persianeval leaderboard</code> خودت نتایج اضافه کن.<br>
    No results yet. The first scheduled weekly run will populate this table — or run
    <code>persianeval run</code> followed by <code>persianeval leaderboard</code> yourself.
  </div>
  {% endif %}

  <div class="tasks">
    {% for task in task_sources %}
    <div class="task-card">
      <b>{{ task.fa }}</b>
      <small>{{ task.en }} · <code>{{ task.name }}</code> · حداقل {{ task.min_samples }} نمونه</small>
    </div>
    {% endfor %}
  </div>

  <footer>
    ساخته‌شده به‌صورت خودکار در <bdi>{{ generated_at }}</bdi> · داده‌های خام:
    <a href="data.json">data.json</a> · روش‌شناسی:
    <a href="https://github.com/Abolfazlrwm/persianeval/blob/main/docs/methodology.md">methodology.md</a>
    · Generated automatically on <bdi>{{ generated_at }}</bdi>.
  </footer>
</div>
<script>
(function () {
  "use strict";
  var table = document.getElementById("board");
  if (!table) { return; }
  var tbody = table.tBodies[0];
  var headers = table.querySelectorAll("th[data-key]");
  headers.forEach(function (th) {
    th.addEventListener("click", function () {
      var rows = Array.prototype.slice.call(tbody.rows);
      var index = th.cellIndex;
      var ascending = th.dataset.dir !== "asc";
      headers.forEach(function (other) {
        other.dataset.dir = "";
        var arrow = other.querySelector(".arrow");
        if (arrow) { arrow.textContent = ""; }
      });
      th.dataset.dir = ascending ? "asc" : "desc";
      var arrow = th.querySelector(".arrow");
      if (arrow) { arrow.textContent = ascending ? "▲" : "▼"; }
      rows.sort(function (a, b) {
        var cellA = a.cells[index];
        var cellB = b.cells[index];
        var rawA = cellA.dataset.v !== undefined ? cellA.dataset.v : cellA.textContent.trim();
        var rawB = cellB.dataset.v !== undefined ? cellB.dataset.v : cellB.textContent.trim();
        var numA = parseFloat(rawA);
        var numB = parseFloat(rawB);
        if (!isNaN(numA) && !isNaN(numB)) {
          return ascending ? numA - numB : numB - numA;
        }
        return ascending ? rawA.localeCompare(rawB, "fa") : rawB.localeCompare(rawA, "fa");
      });
      rows.forEach(function (row) { tbody.appendChild(row); });
    });
  });
})();
</script>
</body>
</html>
